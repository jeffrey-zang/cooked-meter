# Client ID of your Spotify app (https://developer.spotify.com/dashboard).
# Add <your-site>/callback as a Redirect URI in the Spotify app settings.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional: Last.fm API key (https://www.last.fm/api/account/create) for the
# "plays" and "your plays" questions. Server-side only, never exposed to the browser.
LASTFM_API_KEY=
